# ─────────────────────────────────────────────────────────────
#  Syncle Web configuration
#  Copy to ".env.local" (the run scripts do this automatically).
# ─────────────────────────────────────────────────────────────

# Where the web server forwards /api calls. Must match PORT in apps/api/.env.
# The browser always calls a relative "/api" on the web app's own origin, and
# the proxy in src/app/api/[...path]/route.ts passes it on from here — so the
# API's address is never baked into the browser bundle.
SYNCLE_API_ORIGIN=http://127.0.0.1:4002

# Port the web app runs on.
WEB_PORT=3002

# Optional: set an absolute URL (e.g. https://api.example.com/api) to have the
# browser call the API directly and skip the proxy. CORS then applies, so the
# API's WEB_ORIGIN must list this web app's origin.
# NEXT_PUBLIC_API_URL=
