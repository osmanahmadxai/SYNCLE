{
  "name": "@syncle/api",
  "version": "1.3.0",
  "private": true,
  "description": "Syncle backend — NestJS API that runs cross-engine database-to-database sync bridges (replay, polling, and CDC).",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && prisma migrate deploy && nest start --watch",
    "start": "prisma generate && prisma migrate deploy && node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@powersync/mysql-zongji": "0.6.0",
    "@prisma/client": "^5.22.0",
    "@syncle/core": "workspace:*",
    "bullmq": "^5.34.0",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "mongodb": "^6.21.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.1",
    "pg-logical-replication": "^2.0.3",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ssh2": "^1.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/ssh2": "^1.15.5",
    "@vitest/coverage-v8": "^2.1.4",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^2.1.4"
  }
}
