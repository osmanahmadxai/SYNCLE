# ─────────────────────────────────────────────────────────────
#  Syncle API configuration
#  Copy to ".env" (pnpm bootstrap does this automatically).
# ─────────────────────────────────────────────────────────────

# Port the API listens on. Must match NEXT_PUBLIC_API_URL in the web app.
PORT=4002

# Browser origin(s) allowed by CORS (comma-separated for more than one).
# Defaults to the local web app (http://localhost:<WEB_PORT or 3002>); set an
# explicit URL when the web app is served elsewhere, e.g. https://bridge.example.com
# WEB_ORIGIN=http://localhost:3002

# ── Metadata store ───────────────────────────────────────────
# Syncle's OWN PostgreSQL database (saved connections, bridges, jobs) — NOT a
# database you connect to. Start one with `docker compose up -d postgres` from
# the repo root; the credentials below match docker-compose.yml (host port 5433
# so it never clashes with a local Postgres on 5432). Point this at any
# Postgres (managed, RDS, etc.) by changing the URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/syncle?schema=public"

# ── Security ─────────────────────────────────────────────────
# Base64 32-byte key. Encrypts stored connection credentials (AES-256-GCM) AND
# signs login session cookies. Leave blank for local dev — a key is generated
# under apps/api/.syncle/. For production, set this and keep it secret
# (changing it later invalidates stored secrets and logs everyone out):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SYNCLE_MASTER_KEY=

# The API is guarded by a single admin account created on first launch via the
# web app's setup screen — there is no signup. Set NODE_ENV=production to mark
# session cookies Secure (HTTPS-only). Session length is configurable in-app
# under Settings › Security.
# NODE_ENV=production

# ── Limits / tuning ──────────────────────────────────────────
# Hard cap on rows returned by a single ad-hoc query.
SYNCLE_MAX_QUERY_ROWS=5000
# Idle milliseconds before a pooled database connection is closed.
SYNCLE_POOL_IDLE_MS=300000
# Where the encryption key + local state live (default: apps/api/.syncle).
# SYNCLE_DATA_DIR=.syncle

# ── Bridge jobs (queue) ──────────────────────────────────────
# Redis backing the BullMQ queue that runs bridge jobs. Start one with
# `docker compose up -d redis` from the repo root. The studio, bridge CRUD and
# payload preview work without Redis — only *running* a job needs it.
REDIS_URL=redis://localhost:6379
# How many bridge jobs may execute concurrently.
SYNCLE_JOB_CONCURRENCY=5

# ── CDC throughput ───────────────────────────────────────────
# A change stream is delivered in batches rather than a row at a time: one
# delivery, one delivery record, one cursor write and one source ack per batch
# instead of per row.
#
# This applies to DATABASE destinations only, where a batch is invisible —
# writes are idempotent upserts keyed by column, so N-at-once and N one-at-a-
# time produce the same table. HTTP destinations keep using the bridge's own
# `batchSize`, because there the batch size is the payload the receiver sees.
# SYNCLE_CDC_BATCH_SIZE=100000
# How long a partial batch waits for more changes before it is sent anyway.
# SYNCLE_CDC_LINGER_MS=50
# Ceiling on the bytes held in one batch. A row cap alone is unsafe — 100,000
# narrow rows is a few megabytes, 100,000 wide ones could be gigabytes — so the
# row size is estimated once per batch and whichever limit binds first wins.
# SYNCLE_CDC_BATCH_BYTES=67108864

# ── CDC spool (optional) ─────────────────────────────────────
# Put a durable spool (a Redis Stream) between the change reader and the
# destination writer. With it on, the source is acknowledged as soon as changes
# are spooled, so a slow or unreachable destination no longer holds the SOURCE's
# log open — the failure mode where a Postgres replication slot stops advancing
# and WAL fills the production database's disk.
#
# OFF by default, deliberately. While a change sits in the spool, Redis is the
# ONLY copy of it, so turn this on only where Redis has persistence
# (appendonly yes). That is a durability trade, not a free speed-up.
# SYNCLE_CDC_SPOOL=on
# Unwritten changes held before the reader is throttled. The cap is what stops
# a stalled destination turning into unbounded Redis growth.
# SYNCLE_CDC_SPOOL_MAX=50000

# ── When a delivery fails ────────────────────────────────────
# A live bridge (CDC / watch) set to `onError: continue` does not drop the rows
# it cannot deliver: it isolates them from the rest of their batch and parks
# them, in full, in the bridge's dead-letter queue BEFORE moving its cursor, so
# they can be retried once the cause is fixed. These two bound that, so a
# broken DESTINATION (where every row fails, and none of them is "bad") stops
# the bridge instead of emptying the change stream into the metadata store.
#
# Undelivered rows one bridge may hold. At the limit the bridge stops, cursor
# untouched, and says why — retry or discard the queue, then start it again.
# SYNCLE_DEAD_LETTER_MAX_ROWS=10000
# Batches in a row that may deliver NOTHING before the bridge stops. One bad
# row fails one batch; a destination that is down fails all of them.
# SYNCLE_MAX_CONSECUTIVE_FAILURES=5

# ── What CDC bridges hold on their source ───────────────────────────────────
# A PostgreSQL replication slot makes the server keep every change since the
# slot's position, read or not. A bridge that is paused or failed keeps its
# slot, and the source's disk fills until the database stops accepting writes.
#
# How often (seconds) to measure that, and to retry dropping slots that could
# not be dropped when their bridge was deleted. 0 = off.
# SYNCLE_SLOT_CHECK_SECONDS=60
# WAL pinned by one bridge before it is flagged in the job view and the log.
# SYNCLE_SLOT_WARN_BYTES=1073741824
# WAL pinned by a bridge that is NOT running before Syncle drops its slot to
# protect the source. 0 = never (the default): a dropped slot is a gap in that
# bridge, to be backfilled with a replay. On PostgreSQL 13+ prefer the server's
# own max_slot_wal_keep_size, which also works while Syncle is switched off.
# SYNCLE_SLOT_MAX_BYTES=0

# A Redis CDC bridge that copies its keys before following them has no change
# log to read the meanwhile-changes back from, so it holds them in memory (the
# newest per key) until the copy is done. How many keys it may hold before it
# stops rather than grow without limit. Other engines are not affected.
# SYNCLE_SNAPSHOT_HOLD_MAX=100000

# ── Delivery history ─────────────────────────────────────────────────────────
# Every delivery is recorded with what was sent and what came back, and nothing
# used to remove those rows — a live bridge writes them for as long as it runs.
# These are the DEFAULTS for two settings that can also be changed in the UI
# (Settings > Engine). The delivered / failed / skipped totals are stored on the
# job and are never affected; failed deliveries whose rows still wait in the
# dead-letter queue are never removed.
#
# Days a delivery's details are kept. 0 = for ever.
# SYNCLE_DELIVERY_RETENTION_DAYS=30
# Deliveries a live (watch / CDC) bridge keeps, however recent. 0 = no limit.
# SYNCLE_DELIVERY_MAX_PER_JOB=100000
# How often history is pruned, in minutes. 0 = only on demand
# (POST /api/bridges/retention/run).
# SYNCLE_RETENTION_SWEEP_MINUTES=60

# ── Monitoring and alerts ────────────────────────────────────────────────────
# How much the API logs: error | warn | log | debug | verbose. `warn` (default)
# is what it always logged; `log` adds the lifecycle lines (a bridge started, a
# slot released, a retention sweep).
# SYNCLE_LOG_LEVEL=warn
# GET /api/metrics (Prometheus text format) exists only when this is set, and
# answers only to `Authorization: Bearer <token>`. Unset = 404.
# SYNCLE_METRICS_TOKEN=
# Alert channels (Settings › Alerts) are throttled per channel, kind of event
# and bridge: one alert per this many seconds, the next one saying how many were
# held back. 0 sends every one.
# SYNCLE_ALERT_THROTTLE_SECONDS=300
# Verifying a bridge that is delivering: a row that looks wrong is looked at again
# this many milliseconds later, from both ends, before it counts as a difference
# (a change that was only in flight is not one).
# SYNCLE_VERIFY_RECHECK_MS=1500
