#!/usr/bin/env bash
# Syncle launcher — controls the bundled Docker stack (web GUI + API + Postgres
# + Redis). Installed to your PATH by install.sh.
#
# Everything it needs lives in ${SYNCLE_HOME:-~/.syncle}: the compose file, and
# an .env holding the encryption key and the pinned image tag. The app image is
# pulled prebuilt from GHCR — nothing is compiled on this machine.
set -euo pipefail

# exported so `syncle update` (which re-runs the installer in a child shell)
# writes back to the same place a custom SYNCLE_HOME points at
export SYNCLE_HOME="${SYNCLE_HOME:-$HOME/.syncle}"
COMPOSE_FILE="$SYNCLE_HOME/docker-compose.app.yml"
ENV_FILE="$SYNCLE_HOME/.env"
INSTALLER="https://raw.githubusercontent.com/osmanahmadxai/SYNCLE/main/install.sh"
WEB_URL="http://localhost:${SYNCLE_PORT:-3002}"

die() { printf 'syncle: %s\n' "$1" >&2; exit 1; }

[ -f "$COMPOSE_FILE" ] || die "not installed — no compose file at $COMPOSE_FILE. Re-run the installer."
command -v docker >/dev/null 2>&1 || die "Docker is not installed. See https://docs.docker.com/get-docker/"
docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required (comes with Docker Desktop / the compose plugin)."

# --env-file is explicit rather than relying on compose picking up .env from the
# working directory — `syncle` is run from wherever the user happens to be
compose() {
  if [ -f "$ENV_FILE" ]; then
    docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"
  else
    docker compose -f "$COMPOSE_FILE" "$@"
  fi
}

open_url() {
  if command -v open >/dev/null 2>&1; then open "$1"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1"
  else printf 'Open %s in your browser.\n' "$1"; fi
}

wait_for_web() {
  printf 'Waiting for the web GUI'
  for _ in $(seq 1 60); do
    if curl -fsS -o /dev/null "$WEB_URL" 2>/dev/null; then printf ' ready.\n'; return 0; fi
    printf '.'; sleep 2
  done
  printf '\n'
  printf 'Still starting — check `syncle logs`.\n'
}

usage() {
  cat <<EOF
Syncle — keep any databases in sync, with a web GUI.

Usage: syncle <command>

  up          Download (first run) and start everything, then open the GUI
  down        Stop and remove the containers (data is kept)
  restart     Restart the running containers
  status      Show container status
  logs [svc]  Follow logs (optionally: api | web | postgres | redis)
  open        Open the web GUI in your browser
  update      Fetch the newest release and restart
  uninstall   Stop everything and delete all data (asks first)
  version     Show the installed Syncle version

Environment:
  SYNCLE_PORT   port for the web GUI (default 3002)
  SYNCLE_HOME   where config lives   (default ~/.syncle)
EOF
}

cmd="${1:-up}"
case "$cmd" in
  up)
    # pull first so a slow download isn't mistaken for a hung startup
    printf 'Downloading images (first run takes a minute)...\n'
    compose pull --quiet
    compose up -d
    wait_for_web
    open_url "$WEB_URL"
    printf 'Syncle is running at %s\n' "$WEB_URL"
    ;;
  down)    compose down ;;
  restart) compose restart ;;
  status|ps) compose ps ;;
  logs)    shift || true; compose logs -f "$@" ;;
  open)    open_url "$WEB_URL" ;;
  update)
    # re-runs the installer, which refreshes the compose file and launcher and
    # re-pins the image to the newest release. the encryption key is preserved.
    command -v curl >/dev/null 2>&1 || die "curl is required to update."
    curl -fsSL "$INSTALLER" | sh
    compose pull --quiet
    compose up -d
    printf 'Updated. %s\n' "$WEB_URL"
    ;;
  uninstall)
    printf 'This deletes all Syncle containers, images and DATA. Continue? [y/N] '
    read -r ans
    case "$ans" in
      y|Y)
        compose down -v --rmi all || true
        rm -rf "$SYNCLE_HOME"
        # Best-effort removal of the launcher from common locations.
        for d in /usr/local/bin "$HOME/.local/bin"; do
          [ -f "$d/syncle" ] && { rm -f "$d/syncle" 2>/dev/null || sudo rm -f "$d/syncle"; }
        done
        printf 'Uninstalled.\n'
        ;;
      *) printf 'Cancelled.\n' ;;
    esac
    ;;
  version|-v|--version)
    printf 'Syncle %s\n' "$(cat "$SYNCLE_HOME/version" 2>/dev/null || echo unknown)"
    ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
